{
  "manifest_version": "0.3",
  "name": "klas-report",
  "display_name": "KLAS Reports",
  "version": "3.1.0",
  "description": "Generate KLAS Member, Deal, Tax, and Active Deals reports (.xlsx) from the live Google Sheet, and answer ad-hoc financial questions.",
  "author": {
    "name": "Yochay Kiriaty"
  },
  "server": {
    "type": "node",
    "entry_point": "index.js",
    "mcp_config": {
      "command": "node",
      "args": [
        "${__dirname}/index.js"
      ]
    }
  },
  "tools": [
    {
      "name": "member_report",
      "description": "Generate a KLAS Member report (.xlsx)."
    },
    {
      "name": "deal_report",
      "description": "Generate a KLAS Deal report (.xlsx)."
    },
    {
      "name": "tax_report",
      "description": "Generate a KLAS tax-withholding report (.xlsx)."
    },
    {
      "name": "active_deals_report",
      "description": "Generate a KLAS Active Deals report (.xlsx) for one calendar year, with per-investor distributions and Non-US tax withholding."
    },
    {
      "name": "klas_context",
      "description": "Snapshot of all Members and Deals for ad-hoc Q&A."
    },
    {
      "name": "auth_status",
      "description": "Show the authenticated Google account."
    },
    {
      "name": "auth_login",
      "description": "Start Google sign-in (opens a browser)."
    }
  ],
  "compatibility": {
    "claude_desktop": ">=0.10.0",
    "platforms": [
      "darwin",
      "win32"
    ],
    "runtimes": {
      "node": ">=18.0.0"
    }
  }
}
